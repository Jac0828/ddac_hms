# HMS API Environment Variables
# Copy these values to AWS Elastic Beanstalk Environment Variables
# For local development, use appsettings.Development.json

# Database Connection String
# Format: Host=<RDS_ENDPOINT>;Port=5432;Database=<DB_NAME>;Username=<USERNAME>;Password=<PASSWORD>;SSL Mode=Require;Trust Server Certificate=true;Include Error Detail=true;Timeout=30;Command Timeout=30
ConnectionStrings__Default=

# JWT Configuration
# Generate a strong random key (at least 32 characters)
# You can generate one using: openssl rand -base64 32
Jwt__Key=
Jwt__Issuer=HMS.Api
Jwt__Audience=HMS.Api
Jwt__ExpirationInMinutes=60

# Email Settings
EmailSettings__Host=smtp.gmail.com
EmailSettings__Port=587
EmailSettings__EnableSSL=true
EmailSettings__Email=
EmailSettings__Password=

# AWS Configuration
# For production, use IAM Role instead of AccessKey/SecretKey
AWS__AccessKey=
AWS__SecretKey=
AWS__SessionToken=
AWS__Region=us-east-1

# CORS Configuration
# Comma-separated list of allowed origins
# Example: http://localhost:5173,http://localhost:3000,https://yourdomain.com
CORS__AllowedOrigins=

# Application Settings
ASPNETCORE_ENVIRONMENT=Development
RUN_MIGRATIONS=true
